
# ==========================================================
# Donor Trust Quota Application
# Environment Configuration Template
# File: .env.example
# ==========================================================
#
# Copy to .env for local development:
#   cp .env.example .env
#
# Never commit .env or production secrets to GitHub.
# Commit only this example file with blank secret values.
#
# This is an independent application-preparation service,
# NOT an official WBMCC submission service.
#
# IMPORTANT:
# A setting has no effect unless application code implements it.
# Confirm actual support in server.js and the installed packages.
#
# Privacy defaults:
# - No third-party analytics or advertising by default.
# - Never log applicant payloads, documents, tokens or cookies.
# - Keep identity documents in private storage.
# - Never put secrets, personal data or session IDs in URLs.
# - Collect only information required for the stated purpose.
# ==========================================================


# ----------------------------------------------------------
# 1. APPLICATION
# ----------------------------------------------------------

NODE_ENV=development
APP_NAME="Donor Trust Quota Application"
APP_BASE_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1


# ----------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ----------------------------------------------------------
# Supply the real connection string in your private .env.
# Do not put the database password in source code.
#
# Production providers may require verified TLS.
# Do not disable certificate verification to fix TLS errors.

DATABASE_URL=

# Local development only; enable provider-required TLS in production.
PGSSL=false

# Additional pool settings; effective only if server.js reads them.
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000


# ----------------------------------------------------------
# 3. AUTHENTICATION AND SESSIONS
# ----------------------------------------------------------
# Generate a unique random secret locally.
# Never use the example values as production credentials.
#
# Example generation:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Use a different random value for every secret.

SESSION_SECRET=
SESSION_COOKIE_NAME=donor_quota_session
SESSION_TTL_MS=28800000

# Local HTTP development only.
# Set true when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Separate administrator API credential.
# Keep server-side only; never embed it in browser JavaScript.
ADMIN_API_TOKEN=


# ----------------------------------------------------------
# 4. NETWORK AND API SECURITY
# ----------------------------------------------------------
# Only trust proxy settings that match your actual deployment.
# false means do not trust forwarded client-IP headers.
# If using a proxy, configure the exact trusted hop count/topology.

TRUST_PROXY=false

# Comma-separated exact browser origins; no wildcard in production.
CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

JSON_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# Enable only if the application actually implements CSRF protection.
CSRF_PROTECTION_ENABLED=false


# ----------------------------------------------------------
# 5. PRIVATE FILE UPLOADS
# ----------------------------------------------------------
# Never expose private upload directories using express.static().
# Validate file contents, not just the extension or browser MIME type.
# Enforce per-file and per-request limits in server code.

UPLOAD_DIR=private-uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_APPLICATION=15
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png
UPLOADS_PUBLICLY_ACCESSIBLE=false

# Choose and implement a storage provider before production use.
# Local storage is suitable only when the server filesystem is
# persistent, protected and backed up appropriately.

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# Keep uploaded files outside the public web root.
# Authorize every file read/download.
# Consider malware scanning and quarantine before accepting files.


# ----------------------------------------------------------
# 6. PDF GENERATION
# ----------------------------------------------------------
# These values are proposals until the PDF code uses them.
# Store generated PDFs privately and authorize every download.

PDF_OUTPUT_DIR=private-generated
PDF_FILENAME_PREFIX=donor-quota-application
PDF_INCLUDE_SUBMISSION_REFERENCE=true


# ----------------------------------------------------------
# 7. APPLICATION WORKFLOW
# ----------------------------------------------------------

APPLICATION_REFERENCE_PREFIX=DTQ
APPLICATION_DRAFT_TTL_DAYS=30
REQUIRE_CONSENT_BEFORE_SUBMISSION=true

# A local draft reference is not proof of official submission.
# Generate a submission reference only after a successful,
# committed database transaction.


# ----------------------------------------------------------
# 8. PRIVACY-CONSCIOUS LOGGING
# ----------------------------------------------------------
# Never log authorization headers, cookies, session IDs,
# uploaded files, applicant payloads, identity numbers,
# signatures, passwords or API credentials.

LOG_LEVEL=info
LOG_REDACT_SENSITIVE_DATA=true
LOG_REQUEST_BODIES=false
LOG_RESPONSE_BODIES=false

# Use structured logs with an allowlist of safe fields.
# Do not assume redaction works unless the logger implements it.


# ----------------------------------------------------------
# 9. OPTIONAL EMAIL NOTIFICATIONS
# ----------------------------------------------------------
# Leave blank until a provider is configured.
# Do not include sensitive application details in email messages.

EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=


# ----------------------------------------------------------
# 10. HEALTH AND READINESS
# ----------------------------------------------------------
# Keep health endpoints free of secrets, connection strings,
# personal data, internal errors and database diagnostics.

HEALTH_CHECK_ENABLED=true

# /health should indicate basic process health.
# /ready should indicate whether required dependencies are ready.
# These routes must actually exist in the application code.


# ----------------------------------------------------------
# 11. RETENTION AND PRIVACY CONTROLS
# ----------------------------------------------------------
# These are policy proposals, not automatic deletion commands.
# Establish a documented retention schedule before enabling cleanup.

AUDIT_LOG_RETENTION_DAYS=180
UPLOAD_RETENTION_DAYS=365
DELETE_EXPIRED_UPLOADS=false

# Implement an authorized cleanup job only after reviewing:
# - legal and operational retention requirements
# - pending applications and disputes
# - backups and replicated storage
# - audit requirements and deletion records


# ----------------------------------------------------------
# 12. OPTIONAL OPERATIONAL CONTROLS
# ----------------------------------------------------------
# These values do nothing until implemented in server.js.

MAINTENANCE_MODE=false
APPLICATION_SUBMISSION_ENABLED=false
MAX_APPLICATIONS_PER_USER=5

# Keep submission disabled until authentication, consent,
# database persistence, upload authorization and error handling
# have been implemented and tested together.

# Enable only when production traffic is guaranteed to use HTTPS.
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# ==========================================================
# END OF TEMPLATE
# ==========================================================
